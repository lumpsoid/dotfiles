[Unit]
Description=Test Graphical Session Target
Wants=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo "Graphical session triggered at $(date)" >> /tmp/graphical-session-test.log'
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
