! Font
*faceName: CascadiaCode
*faceSize: 20
! Modern Blue-Yellow Terminal Theme for xterm/uxterm
! Basic Settings
*background:  #0d2247
*foreground:  #f2d857
*cursorColor: #f2d857
! Black (Normal and Bright)
*color0:      #1e3355
*color8:      #3e5a80
! Red (Normal and Bright)
*color1:      #ff7e67
*color9:      #ff9d8f
! Green (Normal and Bright)
*color2:      #9de07a
*color10:     #b8f0a0
! Yellow (Normal and Bright)
*color3:      #ffda7a
*color11:     #ffe7a3
! Blue (Normal and Bright)
*color4:      #7ab2ff
*color12:     #a0c8ff
! Magenta (Normal and Bright)
*color5:      #c792ea
*color13:     #ddb6f2
! Cyan (Normal and Bright)
*color6:      #7adbe9
*color14:     #a0e9f5
! White (Normal and Bright)
*color7:      #c7d3e0
*color15:     #edf2f7
! xterm specific settings
xterm*background:  #0d2247
xterm*foreground:  #f2d857
xterm*cursorColor: #f2d857
xterm*scrollBar:   false
! uxterm specific settings (generally same as xterm)
UXTerm*background:  #0d2247
UXTerm*foreground:  #f2d857
UXTerm*cursorColor: #f2d857
UXTerm*scrollBar:   false
UXTerm*selectToClipboard: true
! Selection colors
*highlightColor:      #2a4166
*highlightTextColor:  #f2d857

! makes Backspace send ^? (DEL)
UXTerm*backarrowKey: false
