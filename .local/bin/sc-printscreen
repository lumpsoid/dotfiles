#!/usr/bin/env sh
# imagemagick package
# xclip package (x11) / wl-copy + grim + slurp (wayland)

timestamp=$(date +%Y%m%d%H%M%S)
tmp_file="/tmp/screenshot_${timestamp}.png"
out_dir="$HOME/Pictures/Screenshots"
out_file="${out_dir}/${timestamp}.avif"

cleanup() {
    [ -f "$tmp_file" ] && rm -f "$tmp_file"
}
trap cleanup EXIT

capture() {
    if [ "$XDG_SESSION_TYPE" = "x11" ]; then
        import "$tmp_file"
    elif [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        geometry=$(slurp) || return 1
        [ -z "$geometry" ] && notify-send 'Screenshot' 'No area selected' && return 1
        grim -g "$geometry" "$tmp_file"
    else
        notify-send "Screenshot: XDG_SESSION_TYPE not matched"
        exit 1
    fi
}

copy_to_clipboard() {
    if [ "$XDG_SESSION_TYPE" = "x11" ]; then
        xclip -selection clipboard -target image/png -i < "$tmp_file"
    elif [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        wl-copy < "$tmp_file"
    fi
}

if ! capture; then
    notify-send 'Screenshot' 'Action canceled or failed'
    exit 1
fi

[ ! -f "$tmp_file" ] && notify-send 'Screenshot' 'Capture file missing' && exit 1

mkdir -p "$out_dir" || { notify-send 'Screenshot' "Cannot create output dir: $out_dir"; exit 1; }

if ! copy_to_clipboard; then
    notify-send 'Screenshot' 'Failed to copy to clipboard'
    exit 1
fi

if ! magick -quality 57 "$tmp_file" "$out_file"; then
    notify-send 'Screenshot' 'Conversion to AVIF failed'
    exit 1
fi

# Uncomment to use JXL instead:
# cjxl "$tmp_file" "${out_dir}/${timestamp}.jxl" -q 60 --num_threads=4 || \
#     { notify-send 'Screenshot' 'Conversion to JXL failed'; exit 1; }

notify-send 'Screenshot' 'Saved and copied to clipboard'
