#!/bin/bash

# Bootstrap script to install Google Cloud CLI on Arch Linux with XDG compliance
# Author: Auto-generated bootstrap script
# Date: $(date)

set -euo pipefail  # Exit on error, undefined vars, pipe failures

# Color codes for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $(date '+%Y-%m-%d %H:%M:%S') - $1" >&2
}

# Cleanup function
cleanup() {
    local exit_code=$?
    log_info "Cleaning up temporary files..."
    if [[ -n "${TEMP_DIR:-}" && -d "$TEMP_DIR" ]]; then
        rm -rf "$TEMP_DIR"
        log_info "Removed temporary directory: $TEMP_DIR"
    fi
    if [[ $exit_code -ne 0 ]]; then
        log_error "Script failed with exit code: $exit_code"
    fi
    exit $exit_code
}

trap cleanup EXIT

# Setup XDG directories
setup_xdg_dirs() {
    log_info "Setting up XDG directories..."
    
    # Set XDG base directories according to specification
    export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
    export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
    export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
    export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
    
    # Google Cloud specific directories
    readonly GCLOUD_CONFIG_DIR="$XDG_CONFIG_HOME/gcloud"
    readonly GCLOUD_DATA_DIR="$XDG_DATA_HOME/google-cloud-sdk"
    readonly GCLOUD_CACHE_DIR="$XDG_CACHE_HOME/gcloud"
    readonly GCLOUD_STATE_DIR="$XDG_STATE_HOME/gcloud"
    
    log_info "XDG_CONFIG_HOME: $XDG_CONFIG_HOME"
    log_info "XDG_DATA_HOME: $XDG_DATA_HOME"
    log_info "XDG_CACHE_HOME: $XDG_CACHE_HOME"
    log_info "XDG_STATE_HOME: $XDG_STATE_HOME"
    
    # Create directories if they don't exist
    for dir in "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME" \
               "$GCLOUD_CONFIG_DIR" "$GCLOUD_CACHE_DIR" "$GCLOUD_STATE_DIR"; do
        if [[ ! -d "$dir" ]]; then
            log_info "Creating directory: $dir"
            mkdir -p "$dir"
            log_success "Created directory: $dir"
        else
            log_info "Directory already exists: $dir"
        fi
    done
    
    log_info "Google Cloud XDG directories:"
    log_info "  Config: $GCLOUD_CONFIG_DIR"
    log_info "  Data: $GCLOUD_DATA_DIR"
    log_info "  Cache: $GCLOUD_CACHE_DIR"
    log_info "  State: $GCLOUD_STATE_DIR"
}

# Check prerequisites
check_prerequisites() {
    log_info "Checking prerequisites..."
    
    local missing_deps=()
    
    # Check for required commands
    for cmd in curl tar python3; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_deps+=("$cmd")
            log_warning "Missing dependency: $cmd"
        else
            log_info "Found dependency: $cmd ($(command -v "$cmd"))"
        fi
    done
    
    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        log_error "Missing dependencies: ${missing_deps[*]}"
        log_info "Install missing dependencies with: sudo pacman -S ${missing_deps[*]}"
        return 1
    fi
    
    log_success "All prerequisites satisfied"
}

# Download Google Cloud CLI
download_gcloud() {
    log_info "Setting up temporary download directory..."
    TEMP_DIR=$(mktemp -d)
    log_info "Temporary directory: $TEMP_DIR"
    
    cd "$TEMP_DIR"
    
    local download_url="https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz"
    local archive_name="google-cloud-cli-linux-x86_64.tar.gz"
    
    log_info "Downloading Google Cloud CLI from: $download_url"
    log_info "Starting download..."
    
    if curl -L --progress-bar -o "$archive_name" "$download_url"; then
        log_success "Download completed successfully"
    else
        log_error "Download failed"
        return 1
    fi
    
    # Verify download
    if [[ -f "$archive_name" ]]; then
        local file_size=$(stat -c%s "$archive_name")
        log_info "Downloaded file size: $file_size bytes"
        
        if [[ $file_size -lt 1000000 ]]; then  # Less than 1MB seems suspicious
            log_warning "Downloaded file seems unusually small, but continuing..."
        fi
    else
        log_error "Downloaded file not found"
        return 1
    fi
}

# Extract and install
extract_and_install() {
    log_info "Extracting Google Cloud CLI archive..."
    
    if tar -tzf google-cloud-cli-linux-x86_64.tar.gz | head -5; then
        log_info "Archive contents preview shown above"
    else
        log_warning "Could not preview archive contents"
    fi
    
    log_info "Extracting to current directory..."
    if tar -xzf google-cloud-cli-linux-x86_64.tar.gz; then
        log_success "Extraction completed"
    else
        log_error "Extraction failed"
        return 1
    fi
    
    # Verify extraction
    if [[ -d "google-cloud-sdk" ]]; then
        log_success "Found extracted google-cloud-sdk directory"
        log_info "Contents of google-cloud-sdk:"
        ls -la google-cloud-sdk/ | head -10
    else
        log_error "google-cloud-sdk directory not found after extraction"
        return 1
    fi
    
    # Move to XDG data directory
    log_info "Moving Google Cloud SDK to: $GCLOUD_DATA_DIR"
    
    if [[ -d "$GCLOUD_DATA_DIR" ]]; then
        log_warning "Existing installation found, backing up..."
        mv "$GCLOUD_DATA_DIR" "${GCLOUD_DATA_DIR}.backup.$(date +%s)"
        log_info "Backed up existing installation"
    fi
    
    if mv google-cloud-sdk "$GCLOUD_DATA_DIR"; then
        log_success "Moved Google Cloud SDK to data directory"
    else
        log_error "Failed to move Google Cloud SDK"
        return 1
    fi
}

# Run installation script
run_installation() {
    log_info "Running Google Cloud SDK installation script..."
    
    local install_script="$GCLOUD_DATA_DIR/install.sh"
    
    if [[ ! -f "$install_script" ]]; then
        log_error "Installation script not found: $install_script"
        return 1
    fi
    
    log_info "Making installation script executable..."
    chmod +x "$install_script"
    
    # Set environment variables for XDG compliance
    export CLOUDSDK_CONFIG="$GCLOUD_CONFIG_DIR"
    export CLOUDSDK_CACHE_DIR="$GCLOUD_CACHE_DIR"
    
    log_info "Running installation with the following settings:"
    log_info "  - Config directory: $CLOUDSDK_CONFIG"
    log_info "  - Cache directory: $CLOUDSDK_CACHE_DIR"
    log_info "  - Installation directory: $GCLOUD_DATA_DIR"
    log_info "  - Non-interactive mode: enabled"
    log_info "  - Path modification: disabled"
    log_info "  - Command completion: enabled"
    
    # Run the installer non-interactively
    if "$install_script" \
        --quiet \
        --disable-installation-options \
        --path-update=false \
        --command-completion=true \
        --install-python=false; then
        log_success "Google Cloud SDK installation completed"
    else
        log_error "Installation script failed"
        return 1
    fi
}

# Verify installation
verify_installation() {
    log_info "Verifying installation..."
    
    # Test if gcloud binary exists and is executable
    local gcloud_binary="$GCLOUD_DATA_DIR/bin/gcloud"
    if [[ -x "$gcloud_binary" ]]; then
        log_success "Found executable gcloud binary: $gcloud_binary"
        
        # Test version command with XDG environment
        log_info "Testing gcloud version command with XDG environment..."
        if CLOUDSDK_CONFIG="$GCLOUD_CONFIG_DIR" CLOUDSDK_CACHE_DIR="$GCLOUD_CACHE_DIR" "$gcloud_binary" version --quiet; then
            log_success "gcloud version command works with XDG compliance"
        else
            log_warning "gcloud version command failed, but binary exists"
        fi
    else
        log_error "gcloud binary not found or not executable: $gcloud_binary"
        return 1
    fi
    
    # Check all XDG directories
    for dir_name in "Configuration" "Cache" "State"; do
        case $dir_name in
            "Configuration") dir_path="$GCLOUD_CONFIG_DIR" ;;
            "Cache") dir_path="$GCLOUD_CACHE_DIR" ;;
            "State") dir_path="$GCLOUD_STATE_DIR" ;;
        esac
        
        if [[ -d "$dir_path" ]]; then
            log_success "$dir_name directory exists: $dir_path"
        else
            log_info "$dir_name directory will be created on first run: $dir_path"
        fi
    done
}

# Print shell configuration instructions
print_shell_config() {
    log_info "Preparing shell configuration instructions..."
    
    echo
    echo "=========================================="
    echo "MANUAL SHELL CONFIGURATION REQUIRED"
    echo "=========================================="
    echo
    echo "Add the following to your shell configuration file:"
    echo
    
    # XDG Compliance configuration - all directories
    echo "# XDG Compliance for Google Cloud SDK"
    echo "export CLOUDSDK_CONFIG=\"$GCLOUD_CONFIG_DIR\""
    echo "export CLOUDSDK_CACHE_DIR=\"$GCLOUD_CACHE_DIR\""
    echo
    echo "# Optional: Set additional XDG environment variables if not already set"
    echo "export XDG_CONFIG_HOME=\"\${XDG_CONFIG_HOME:-\$HOME/.config}\""
    echo "export XDG_DATA_HOME=\"\${XDG_DATA_HOME:-\$HOME/.local/share}\""
    echo "export XDG_CACHE_HOME=\"\${XDG_CACHE_HOME:-\$HOME/.cache}\""
    echo "export XDG_STATE_HOME=\"\${XDG_STATE_HOME:-\$HOME/.local/state}\""
    echo
    
    # PATH configuration
    echo "# Add gcloud to PATH"
    echo "export PATH=\"$GCLOUD_DATA_DIR/bin:\$PATH\""
    echo
    
    # Shell completion configuration
    echo "# Google Cloud SDK shell completion (choose your shell)"
    echo
    echo "# For Bash (~/.bashrc):"
    echo "if [[ -f \"$GCLOUD_DATA_DIR/completion.bash.inc\" ]]; then"
    echo "    source \"$GCLOUD_DATA_DIR/completion.bash.inc\""
    echo "fi"
    echo
    echo "# For Zsh (~/.zshrc):"
    echo "if [[ -f \"$GCLOUD_DATA_DIR/completion.zsh.inc\" ]]; then"
    echo "    source \"$GCLOUD_DATA_DIR/completion.zsh.inc\""
    echo "fi"
    echo
    echo "# For Fish (~/.config/fish/config.fish):"
    echo "if test -f \"$GCLOUD_DATA_DIR/completion.fish.inc\""
    echo "    source \"$GCLOUD_DATA_DIR/completion.fish.inc\""
    echo "end"
    echo
    echo "=========================================="
    echo "SHELL CONFIGURATION FILES LOCATIONS"
    echo "=========================================="
    echo
    echo "Add the above configuration to your shell's RC file:"
    echo "  • Bash: ~/.bashrc"
    echo "  • Zsh: ~/.zshrc"
    echo "  • Fish: ~/.config/fish/config.fish"
    echo
    echo "After editing your shell configuration:"
    echo "  1. Restart your terminal, or"
    echo "  2. Source your configuration file:"
    echo "     source ~/.bashrc    # for bash"
    echo "     source ~/.zshrc     # for zsh"
    echo
}

# Print installation summary
print_summary() {
    log_success "Google Cloud CLI installation completed!"
    echo
    echo "=== Installation Summary ==="
    echo "Installation directory: $GCLOUD_DATA_DIR"
    echo "Configuration directory: $GCLOUD_CONFIG_DIR"
    echo "Cache directory: $GCLOUD_CACHE_DIR"
    echo "State directory: $GCLOUD_STATE_DIR"
    echo
    echo "=== Next Steps ==="
    echo "1. Add the shell configuration shown above to your shell RC file"
    echo "2. Restart your shell or source your configuration file"
    echo "3. Initialize gcloud: gcloud init"
    echo "4. Authenticate: gcloud auth login"
    echo
    echo "=== XDG Compliance ==="
    echo "This installation follows XDG Base Directory Specification:"
    echo "- Config: \$XDG_CONFIG_HOME/gcloud ($GCLOUD_CONFIG_DIR)"
    echo "- Data: \$XDG_DATA_HOME/google-cloud-sdk ($GCLOUD_DATA_DIR)"
    echo "- Cache: \$XDG_CACHE_HOME/gcloud ($GCLOUD_CACHE_DIR)"
    echo "- State: \$XDG_STATE_HOME/gcloud ($GCLOUD_STATE_DIR)"
    echo
    echo "Environment variables set:"
    echo "- CLOUDSDK_CONFIG: Controls where gcloud stores configuration"
    echo "- CLOUDSDK_CACHE_DIR: Controls where gcloud stores cache files"
    echo
    log_info "Installation log completed at $(date)"
}

# Main execution
main() {
    log_info "Starting Google Cloud CLI installation on Arch Linux"
    log_info "Script started at $(date)"
    
    setup_xdg_dirs
    check_prerequisites
    download_gcloud
    extract_and_install
    run_installation
    verify_installation
    print_shell_config
    print_summary
    
    log_success "Bootstrap script completed successfully!"
}

# Execute main function
main "$@"
