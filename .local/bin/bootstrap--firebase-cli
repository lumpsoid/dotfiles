#!/bin/bash

# Bootstrap Firebase CLI Script
set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔥 Firebase CLI Bootstrap Script${NC}"
echo "=================================="

# XDG-compliant directories
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_BIN_HOME="${XDG_BIN_HOME:-$HOME/.local/bin}"
FIREBASE_DIR="$XDG_DATA_HOME/firebase-cli"
FIREBASE_BINARY_PATH="$FIREBASE_DIR/firebase"
FIREBASE_SYMLINK_PATH="$XDG_BIN_HOME/firebase"

# Create the directories if they don't exist
echo -e "${YELLOW}📁 Creating directories...${NC}"
mkdir -p "$FIREBASE_DIR"
mkdir -p "$XDG_BIN_HOME"

# Download Firebase CLI binary
echo -e "${YELLOW}⬇️  Downloading Firebase CLI binary...${NC}"
if curl -L -o "$FIREBASE_BINARY_PATH" "https://firebase.tools/bin/linux/latest"; then
    echo -e "${GREEN}✅ Download completed successfully${NC}"
else
    echo -e "${RED}❌ Failed to download Firebase CLI binary${NC}"
    exit 1
fi

# Make the binary executable
echo -e "${YELLOW}🔧 Making binary executable...${NC}"
chmod +x "$FIREBASE_BINARY_PATH"

# Create symlink in bin directory
echo -e "${YELLOW}🔗 Creating symlink in bin directory...${NC}"
ln -sf "$FIREBASE_BINARY_PATH" "$FIREBASE_SYMLINK_PATH"

echo -e "${GREEN}✅ Firebase CLI installed at: $FIREBASE_BINARY_PATH${NC}"
echo -e "${GREEN}✅ Symlink created at: $FIREBASE_SYMLINK_PATH${NC}"
echo

# Check if the bin directory is already in PATH
if [[ ":$PATH:" == *":$XDG_BIN_HOME:"* ]]; then
    echo -e "${GREEN}✅ $XDG_BIN_HOME is already in your PATH${NC}"
else
    echo -e "${YELLOW}⚠️  IMPORTANT: Add the following line to your shell configuration file:${NC}"
    echo
    echo -e "${BLUE}export PATH=\"\$PATH:$XDG_BIN_HOME\"${NC}"
    echo
    echo "Add this to one of the following files based on your shell:"
    echo "  • ~/.bashrc (for Bash)"
    echo "  • ~/.zshrc (for Zsh)"
    echo "  • ~/.config/fish/config.fish (for Fish)"
    echo
    echo "Then restart your terminal or run: source ~/.bashrc (or your shell config file)"
fi

echo
echo -e "${YELLOW}🚀 Next steps:${NC}"
echo "1. Add the export PATH line above to your shell configuration (if not already done)"
echo "2. Restart your terminal or source your shell config"
echo -e "3. Run: ${BLUE}firebase login${NC} to authenticate with Firebase"
echo
echo -e "${GREEN}🎉 Firebase CLI installation complete!${NC}"
echo
echo -e "${BLUE}📍 Installation locations:${NC}"
echo "  Binary: $FIREBASE_BINARY_PATH"
echo "  Symlink: $FIREBASE_SYMLINK_PATH"
