#!/usr/bin/env bash
# weather.sh — current temp + rain/snow chance + high temp with XDG cache
# Output: ☔--% 🥶--° 🌞--°

set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/weather"
CACHE_FILE="$CACHE_DIR/belgrade.json"
CACHE_TTL=1800  # 30 minutes in seconds
URL="https://wttr.in/Belgrade?format=j1"

mkdir -p "$CACHE_DIR"

# Check if cache is fresh
use_cache=false
if [[ -f "$CACHE_FILE" ]]; then
    cache_age=$(( $(date +%s) - $(date -r "$CACHE_FILE" +%s 2>/dev/null || echo 0) ))
    if (( cache_age < CACHE_TTL )); then
        use_cache=true
    fi
fi

if $use_cache; then
    data=$(cat "$CACHE_FILE")
else
    data=$(curl -fsSL "$URL") || { echo "Error: failed to fetch weather" >&2; exit 1; }
    echo "$data" > "$CACHE_FILE"
fi

# Parse values
rain=$(echo "$data"    | grep -o '"chanceofrain": *"[^"]*"'  | head -1 | grep -o '[0-9]*')
temp_c=$(echo "$data"  | grep -o '"temp_C": *"[^"]*"'        | head -1 | grep -o '\-\?[0-9]*')
max_c=$(echo "$data"   | grep -o '"maxtempC": *"[^"]*"'      | head -1 | grep -o '\-\?[0-9]*')

# Fallbacks
rain="${rain:-0}"
temp_c="${temp_c:-?}"
max_c="${max_c:-?}"

echo "☔${rain}% 🥶${temp_c}° 🌞${max_c}°"
