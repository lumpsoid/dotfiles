#!/usr/bin/env bash
echo "Starting ssh-agent setup at $(date)" >> /home/qq/start.log

# Kill any existing ssh-agent
pkill -u $(whoami) ssh-agent 2>/dev/null

# Start ssh-agent and save env vars to a file
ssh-agent -s > ~/.ssh/agent-env
source ~/.ssh/agent-env

echo "SSH_AGENT_PID: $SSH_AGENT_PID" >> /home/qq/start.log
echo "SSH_AUTH_SOCK: $SSH_AUTH_SOCK" >> /home/qq/start.log

if ssh-add ~/.ssh/id_ssh_git 2>>/home/qq/start.log; then
    echo "Git--start completed at $(date)" >> /home/qq/start.log
else
    echo "Git--start error: ssh-add failed with exit code $?" >> /home/qq/start.log
fi
